    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "typescript": "6.0.3"
