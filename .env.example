NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production value: https://www.iwannapee.lol
NEXT_PUBLIC_GA4_ID=G-061DRKJ3ET
# Optional HTML-tag verification token from Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Server-only. Do not prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SECRET_KEY=
# Hosted Checkout is created on the server; no publishable Stripe key is needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_INTEGRATION_IDENTIFIER=iwannapee_qnrvkzpt

# Cloudflare Turnstile. The secret values are server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_SESSION_SECRET=
RATE_LIMIT_SECRET=
CRON_SECRET=

# Provider endpoints. Public community endpoints are development fallbacks only.
GEOCODER_BASE_URL=https://photon.komoot.io
# Server-only reverse geocoding for one-time dataset imports. Geoapify results
# are cached locally and require Geoapify attribution when displayed.
GEOAPIFY_API_KEY=
RESTROOM_GEOJSON_PATH=
# Only for a disposable restore-test project; never point these at production.
SUPABASE_DB_URL=
SUPABASE_RESTORE_TEST_DB_URL=
SUPABASE_RESTORE_TEST_URL=
SUPABASE_RESTORE_TEST_SECRET_KEY=
RESTROOM_DATA_API_URL=https://overpass-api.de/api/interpreter
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Owner-only moderation and role management. Comma-separated exact emails.
OWNER_EMAILS=

# Optional Sentry error monitoring.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Default offer: $5 for seven days, shown within five miles.
AD_PRICE_CENTS=500
AD_DURATION_DAYS=7
AD_RADIUS_METERS=8047
AD_MAX_PLACEMENT_BID_CENTS=10000
